{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Xcompute",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "autogenerate": false
    },
    "mdx": {
      "server": "https://xcompute.us",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navbar": {
    "links": [
        {
          "label": "控制台",
          "href": "https://xcompute.us/dashboard/overview"
        },
        {
          "label": "模型定价",
          "href": "https://xcompute.us/pricing"
        }
    ],
    "primary": {
      "type": "button",
      "label": "获取 API Key",
      "href": "https://xcompute.us/keys"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "控制台",
          "icon": "house",
          "href": "https://xcompute.us/dashboard/overview"
        },
        {
          "anchor": "API 密钥",
          "icon": "key",
          "href": "https://xcompute.us/keys"
        },
        {
          "anchor": "模型定价",
          "icon": "dollar-sign",
          "href": "https://xcompute.us/pricing"
        }
      ]
    },
    "tabs": [
      {
        "tab": "快速入门",
        "groups": [
          {
            "group": "开始使用",
            "pages": [
              "file",
              "computer-basics",
              "agent"
            ]
          },
          {
            "group": "日常任务",
            "pages": [
              "workbuddy"
            ]
          },
          {
            "group": "代码任务",
            "pages": [
              "opencode-install",
              "codex-cli-app"
            ]
          }
        ]
      },
      {
        "tab": "API 参考",
        "groups": [
          {
            "group": "文本生成",
            "pages": [
              "api-reference/texts/general/new-chat-completions"
            ]
          },
          {
            "group": "图像生成",
            "pages": [
              "api-reference/images/gpt-image-2/generation",
              "api-reference/images/gpt-image-2/async-generation"
            ]
          },
          {
            "group": "任务管理",
            "pages": [
              "api-reference/tasks/new-status"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/APIMart_"
    }
  }
}
