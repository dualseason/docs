{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Xcompute",
  "redirects": [
    {
      "source": "/computer-basics",
      "destination": "/installation-basics"
    },
    {
      "source": "/api-overview",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/api-reference/texts/general/new-chat-completions",
      "destination": "/api-reference/text/chat-completions"
    },
    {
      "source": "/api-reference/images/gpt-image-2/generation",
      "destination": "/api-reference/images/generate"
    },
    {
      "source": "/api-reference/images/gpt-image-2/edits",
      "destination": "/api-reference/images/edit"
    },
    {
      "source": "/api-reference/images/gpt-image-2/async-generation",
      "destination": "/api-reference/images/async-generate"
    },
    {
      "source": "/api-reference/tasks/new-status",
      "destination": "/api-reference/tasks/query"
    }
  ],
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "autogenerate": false
    },
    "mdx": {
      "server": "https://xcompute.us",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "控制台",
        "href": "https://xcompute.us/dashboard/overview"
      },
      {
        "label": "模型定价",
        "href": "https://xcompute.us/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "获取 API Key",
      "href": "https://xcompute.us/keys"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "控制台",
          "icon": "house",
          "href": "https://xcompute.us/dashboard/overview"
        },
        {
          "anchor": "API 密钥",
          "icon": "key",
          "href": "https://xcompute.us/keys"
        },
        {
          "anchor": "模型定价",
          "icon": "dollar-sign",
          "href": "https://xcompute.us/pricing"
        }
      ]
    },
    "tabs": [
      {
        "tab": "快速入门",
        "groups": [
          {
            "group": "开始使用",
            "pages": [
              "file",
              "agent"
            ]
          },
          {
            "group": "日常任务",
            "pages": [
              "workbuddy",
              "opencode"
            ]
          },
          {
            "group": "模型目录",
            "pages": [
              "xcompute-models"
            ]
          }
        ]
      },
      {
        "tab": "API 参考",
        "groups": [
          {
            "group": "API 入门",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "文本生成",
            "pages": [
              "api-reference/text/chat-completions"
            ]
          },
          {
            "group": "图像生成",
            "pages": [
              "api-reference/images/generate",
              "api-reference/images/edit",
              "api-reference/images/async-generate"
            ]
          },
          {
            "group": "任务管理",
            "pages": [
              "api-reference/tasks/query"
            ]
          }
        ]
      },
      {
        "tab": "客户端配置",
        "groups": [
          {
            "group": "配置总览",
            "pages": [
              "agent-installation"
            ]
          },
          {
            "group": "桌面端",
            "pages": [
              "opencode-install",
              "workbuddy-client"
            ]
          },
          {
            "group": "代码客户端",
            "pages": [
              "codex-cli-app",
              "claude-code",
              "lobster",
              "hermes"
            ]
          },
          {
            "group": "基础操作",
            "pages": [
              "node-setup",
              "installation-basics"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/APIMart_"
    }
  }
}
